---
import { SITE, type Mood } from '../consts';
import SiteHeader from '../components/SiteHeader.astro';
import HeroScene from '../components/HeroScene.astro';
import ScenePoster from '../components/ScenePoster.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  /** Titolo della pagina, senza il nome del sito. */
  title?: string;
  /** Descrizione per SEO e Open Graph. */
  description?: string;
  /** Esclude la pagina dagli indici (bozze in dev, pagine di servizio). */
  noindex?: boolean;
  /** Qualità di luce della pagina. Cambia accento e sorgente, mai il layout. */
  mood?: Mood;
  /**
   * Quanta scena. `piena` per la home, `banda` per tutte le altre: stessa
   * acqua, stessa luce, solo inquadrata più stretta dietro la testata.
   */
  scene?: 'piena' | 'banda';
}

const {
  title,
  description = SITE.description,
  noindex = false,
  mood = 'deriva',
  scene = 'banda',
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
---

<!doctype html>
<html lang={SITE.lang} data-mood={mood}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!--
      I tre sottoinsiemi latini servono al primo paint: l'LCP è l'headline,
      e l'headline è testo. Preload + font-display: optional significa che
      il font c'è già quando si dipinge, senza scambi successivi.
    -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/syne-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/space-mono-400-latin.woff2" crossorigin />
    <meta name="theme-color" content="#050507" />

    <!--
      Il poster è sfondo del <body>, non di un elemento: Chrome esclude i
      background di body/html dai candidati LCP, quindi l'headline resta
      l'elemento più grande nel DOM. È anche l'unico modo di avere il
      poster senza JavaScript.
    -->
    <style is:inline set:html={`body{background-image:url(/poster/${mood}.webp)}`}></style>
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>

  <body data-scene={scene}>
    <a class="skip-link" href="#contenuto">Salta al contenuto</a>

    <div class="scene-layer">
      {scene === 'piena' ? <HeroScene /> : <ScenePoster />}
    </div>

    <SiteHeader />
    <main id="contenuto" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  /* Lo skip link vive fuori schermo e rientra appena riceve il focus. */
  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-s);
    inset-block-start: var(--space-s);
    z-index: 10;
    transform: translateY(calc(-100% - var(--space-l)));
    padding: var(--space-2xs) var(--space-s);
    background-color: var(--paper);
    border: 1px solid var(--ink);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }

  main:focus {
    outline: none;
  }

  /* L'altezza della scena vive qui perché la usano due cose che devono
     combaciare: il livello del canvas e il background-size del poster. */
  body {
    --scene-h: clamp(19rem, 48svh, 32rem);
    background-repeat: no-repeat;
    background-position: center top;
    background-size: 100% var(--scene-h);
  }

  body[data-scene='piena'] {
    --scene-h: min(100svh, 54rem);
  }

  @media (max-width: 55.999rem) {
    body {
      --scene-h: clamp(13rem, 34svh, 18rem);
    }
  }

  /* La scena è il fondo della pagina: parte dal bordo alto della finestra,
     copre anche l'header, e non occupa spazio nel flusso. Il canvas che la
     sostituisce vive esattamente nello stesso rettangolo del poster, così
     al cambio non c'è nessuno scarto di inquadratura. */
  .scene-layer {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: var(--scene-h);
    z-index: 0;
    pointer-events: none;
  }

  main {
    position: relative;
    z-index: 1;
  }
</style>
