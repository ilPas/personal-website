---
import { NAV, SITE } from '../consts';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

/** Una voce è corrente se il suo percorso coincide con quello della pagina. */
const isCurrent = (href: string) => {
  // Un link a una sezione non marca la pagina come corrente: si è sulla
  // pagina, non "su Work".
  if (href.includes('#')) return false;
  const target = href.replace(/\/+$/, '') || '/';
  if (target === '/') return path === '/';
  return path === target || path.startsWith(`${target}/`);
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__name" href="/">{SITE.name}</a>

    <nav aria-label="Navigazione principale">
      <ul class="site-header__nav">
        {
          NAV.map((item) => (
            <li>
              <a
                class="site-header__link"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* La scena parte dal bordo alto della finestra e passa dietro l'header:
     un filetto qui taglierebbe l'immagine in due. Al suo posto una
     velatura, che tiene leggibile la navigazione su qualunque fotogramma. */
  .site-header {
    position: relative;
    z-index: 2;
    background: linear-gradient(
      to bottom,
      var(--void) 0%,
      color-mix(in srgb, var(--void) 72%, transparent) 62%,
      transparent 100%
    );
  }

  /* Nessun menu a scomparsa: sotto i 480px l'header va semplicemente a capo. */
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    padding-block: var(--space-s);
  }

  .site-header__name {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
  }

  .site-header__link:hover {
    color: var(--ink);
  }

  .site-header__link[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }
</style>
