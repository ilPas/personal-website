---
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';
import TagList from './TagList.astro';
import TypeBadge from './TypeBadge.astro';
import { formatDate, isoDate } from '../lib/content';

interface Props {
  entry: CollectionEntry<'feed'>;
  headingLevel?: 2 | 3;
}

const { entry, headingLevel = 3 } = Astro.props;
const { title, excerpt, date, type, tags, cover, draft } = entry.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="feed-entry">
  <p class="feed-entry__meta">
    <time datetime={isoDate(date)}>{formatDate(date)}</time>
    <span class="feed-entry__sep" aria-hidden="true">·</span>
    <TypeBadge type={type} />
    {draft && <span class="feed-entry__draft">Bozza</span>}
  </p>

  <Heading class="feed-entry__title">
    <a class="feed-entry__link" href={`/lab/${entry.id}`}>{title}</a>
  </Heading>

  <p class="feed-entry__excerpt">{excerpt}</p>

  {
    /* La copertina compare solo se esiste: niente riquadri vuoti nell'elenco. */
    cover && (
      <div class="feed-entry__cover">
        <Cover cover={cover} ratio="16 / 9" sizes="(min-width: 40rem) 34rem, 92vw" />
      </div>
    )
  }

  <TagList tags={tags} label={`Tag di ${title}`} />
</article>

<style>
  .feed-entry {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .feed-entry:has(.feed-entry__link:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 6px;
    border-radius: var(--radius-md);
  }

  .feed-entry__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .feed-entry__sep {
    color: var(--ink-faint);
  }

  .feed-entry__draft {
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    padding: 0 0.4em;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    font-size: var(--text-2xs);
  }

  .feed-entry__title {
    font-size: var(--text-xl);
  }

  .feed-entry__link {
    text-decoration: none;
  }

  .feed-entry__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* Tutta la voce è cliccabile, ma nel DOM c'è un solo link. */
  .feed-entry__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
  }

  .feed-entry__link:focus-visible {
    outline: none;
  }

  .feed-entry__excerpt {
    color: var(--ink-muted);
  }

  .feed-entry__cover {
    max-width: 34rem;
    margin-block-start: var(--space-2xs);
  }
</style>
