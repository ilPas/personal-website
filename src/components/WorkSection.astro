---
import type { CollectionEntry } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import WorkCard from './WorkCard.astro';

interface Props {
  entries: CollectionEntry<'work'>[];
}

const { entries } = Astro.props;
---

<section class="work-section" aria-labelledby="work-title" id="work">
  <div class="container">
    <SectionHeader eyebrow="Work" title="Qualche progetto per esteso." id="work-title" />

    {
      entries.length > 0 ? (
        <ul class="work-section__list">
          {entries.map((entry) => (
            <li>
              <WorkCard entry={entry} headingLevel={3} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="work-section__empty">I case study stanno arrivando.</p>
      )
    }
  </div>
</section>

<style>
  .work-section {
    padding-block: var(--space-2xl);
    border-block-start: 1px solid var(--line);
    /* Compensa l'header quando si arriva da un'ancora. */
    scroll-margin-block-start: var(--space-m);
  }

  .work-section__list {
    display: grid;
    gap: var(--space-2xl) var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .work-section__empty {
    color: var(--ink-muted);
  }
</style>
