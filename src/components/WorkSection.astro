---
import type { CollectionEntry } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import WorkCard from './WorkCard.astro';

interface Props {
  entries: CollectionEntry<'work'>[];
}

const { entries } = Astro.props;
---

<section class="work-section" aria-labelledby="work-title" id="work">
  <div class="container">
    <SectionHeader eyebrow="Work" title="Qualche progetto per esteso." id="work-title" />

    {
      entries.length > 0 ? (
        <ul class="work-list">
          {entries.map((entry) => (
            <li class="work-list__item">
              <WorkCard entry={entry} headingLevel={3} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="work-section__empty">
          Non c'è ancora niente qui: i case study arrivano quando ho qualcosa da
          raccontare per esteso. Nel frattempo il lavoro in corso passa dal
          <a href="/lab">lab</a>.
        </p>
      )
    }
  </div>
</section>

<style>
  .work-section {
    padding-block: var(--space-2xl);
    border-block-start: 1px solid var(--line);
    scroll-margin-block-start: var(--space-m);
  }

  /* Stesso principio del feed: il filo sta sopra ogni voce, prima
     compresa, così l'elenco regge con due voci come con dieci. */
  .work-list {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .work-list__item {
    padding-block: var(--space-l);
    border-block-start: 1px solid var(--line);
  }

  .work-section__empty {
    max-width: var(--measure);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--line);
    color: var(--ink-muted);
  }

  .work-section__empty a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-dim);
    text-underline-offset: 0.2em;
  }

  .work-section__empty a:hover {
    text-decoration-color: currentColor;
  }
</style>
