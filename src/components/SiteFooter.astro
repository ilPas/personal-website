---
import { SITE, SOCIAL } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__block">
      <p class="site-footer__name">{SITE.name}</p>
      <p class="site-footer__tagline">{SITE.tagline}</p>
    </div>

    <nav class="site-footer__block" aria-label="Contatti e profili">
      <ul class="site-footer__links">
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        {
          SOCIAL.map((item) => (
            <li>
              <a href={item.href} rel="me noopener">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__block site-footer__legal">
      <p>© {year}</p>
      <p><a href="/privacy">Privacy e cookie</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-3xl);
    font-family: var(--font-mono);
    border-block-start: 1px solid var(--line);
    padding-block: var(--space-xl);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
  }

  .site-footer__tagline {
    max-width: 24ch;
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .site-footer__legal {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  @media (min-width: 48rem) {
    .site-footer__legal {
      text-align: end;
    }
  }
</style>
