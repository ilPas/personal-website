---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  cover?: { src: ImageMetadata; alt: string };
  /** Proporzione del riquadro, es. "16 / 9". */
  ratio?: string;
  sizes?: string;
  /** La cover principale di una pagina non va caricata in lazy. */
  priority?: boolean;
  class?: string;
}

const {
  cover,
  ratio = '16 / 10',
  sizes = '(min-width: 60rem) 40rem, 100vw',
  priority = false,
  class: className,
} = Astro.props;
---

{
  cover ? (
    <Image
      class:list={['cover', className]}
      src={cover.src}
      alt={cover.alt}
      widths={[400, 800, 1280]}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      style={`aspect-ratio: ${ratio}`}
    />
  ) : (
    /* Slot neutro: tiene il ritmo del layout finché non ci sono immagini. */
    <div
      class:list={['cover cover--empty', className]}
      style={`aspect-ratio: ${ratio}`}
      aria-hidden="true"
    />
  )
}

<style>
  .cover {
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
    background-color: var(--surface);
  }

  .cover--empty {
    border: 1px solid var(--line);
  }
</style>
