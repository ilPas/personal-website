---
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';
import TagList from './TagList.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  headingLevel?: 2 | 3;
}

const { entry, headingLevel = 3 } = Astro.props;
const { title, excerpt, year, role, client, tags, cover, draft } = entry.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

{/*
  Riga di indice, non card. Il resto della home è a colonna singola e
  rigata: una griglia di tre card era l'unica eccezione, e con titoli che
  vanno a capo tre volte per colonna non reggeva. Qui i dati stanno in una
  colonna stretta a sinistra e il case study occupa la misura di lettura.
*/}
<article class="work-row">
  <div class="work-row__meta">
    <span class="work-row__year">{year}</span>
    <span class="work-row__role">{role}</span>
    {client && <span class="work-row__client">{client}</span>}
    {draft && <span class="work-row__draft">Bozza</span>}
  </div>

  <div class="work-row__body">
    <Heading class="work-row__title">
      <a class="work-row__link" href={`/work/${entry.id}`}>{title}</a>
    </Heading>

    <p class="work-row__excerpt">{excerpt}</p>

    <TagList tags={tags} label={`Tag di ${title}`} />
  </div>

  {
    /* La copertina compare solo se esiste: nessun riquadro in attesa. */
    cover && (
      <div class="work-row__cover">
        <Cover cover={cover} ratio="4 / 3" sizes="(min-width: 64rem) 14rem, 40vw" />
      </div>
    )
  }
</article>

<style>
  .work-row {
    position: relative;
    display: grid;
    gap: var(--space-2xs) var(--space-l);
  }

  .work-row:has(.work-row__link:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 8px;
    border-radius: var(--radius-md);
  }

  /* Sopra i 64rem l'indice si apre: i dati a sinistra, il progetto a
     destra. Sotto, tutto in colonna — che è la stessa cosa, più stretta. */
  @media (min-width: 64rem) {
    .work-row {
      grid-template-columns: 11rem minmax(0, 1fr) auto;
      align-items: start;
    }
  }

  .work-row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.05em;
    color: var(--ink-faint);
  }

  @media (min-width: 64rem) {
    .work-row__meta {
      flex-direction: column;
      gap: var(--space-3xs);
      padding-block-start: 0.5em;
    }
  }

  .work-row__year {
    color: var(--accent);
    font-weight: 700;
  }

  .work-row__draft {
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    padding: 0 0.4em;
    text-transform: uppercase;
  }

  .work-row__body {
    max-width: var(--measure);
  }

  .work-row__title {
    /* Più grande delle voci del feed: è la gerarchia a dire che un case
       study pesa più di una nota. */
    font-size: var(--text-2xl);
  }

  .work-row__link {
    text-decoration: none;
  }

  .work-row__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  /* Tutta la riga è cliccabile, ma nel DOM c'è un solo link. */
  .work-row__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
  }

  .work-row__link:focus-visible {
    outline: none;
  }

  .work-row__excerpt {
    margin-block-start: var(--space-xs);
    color: var(--ink-muted);
  }

  .work-row__body :global(.tag-list) {
    margin-block-start: var(--space-s);
  }

  .work-row__cover {
    inline-size: min(100%, 14rem);
  }
</style>
