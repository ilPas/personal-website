---
import type { CollectionEntry } from 'astro:content';
import FeedCard from './FeedCard.astro';
import { FEED_TYPES, type FeedType } from '../consts';
import { countByType } from '../lib/content';

interface Props {
  entries: CollectionEntry<'feed'>[];
  /** Livello dei titoli delle card, per non saltare un livello nella pagina. */
  headingLevel?: 2 | 3;
}

const { entries, headingLevel = 2 } = Astro.props;

const counts = countByType(entries);

/** Nel filtro compaiono solo i tipi che hanno almeno una entry. */
const availableTypes = (Object.keys(FEED_TYPES) as FeedType[]).filter((type) => counts[type]);

/* Con un solo tipo il filtro non aggiunge niente: non lo mostriamo. */
const showFilter = availableTypes.length > 1;
---

<!--
  Il filtro è interamente in CSS: un gruppo di radio nativi più `:has()`.
  Nessun JavaScript, quindi funziona al primo paint e resta navigabile da
  tastiera con le frecce, come qualunque radiogroup.
-->
<div class="filtered-feed">
  {
    showFilter && (
      <fieldset class="filtered-feed__filter">
        <legend class="filtered-feed__legend">Filtra per tipo</legend>

        <div class="filtered-feed__options">
          <input
            class="filtered-feed__input"
            type="radio"
            name="filtro-tipo"
            id="filtro-tutti"
            checked
          />
          <label class="filtered-feed__label" for="filtro-tutti">
            Tutti <span class="filtered-feed__count">{entries.length}</span>
          </label>

          {availableTypes.map((type) => (
            <>
              <input
                class="filtered-feed__input"
                type="radio"
                name="filtro-tipo"
                id={`filtro-${type}`}
              />
              <label class="filtered-feed__label" for={`filtro-${type}`}>
                {FEED_TYPES[type].label} <span class="filtered-feed__count">{counts[type]}</span>
              </label>
            </>
          ))}
        </div>
      </fieldset>
    )
  }

  {
    entries.length > 0 ? (
      <ul class="filtered-feed__list">
        {entries.map((entry) => (
          <li class="filtered-feed__item" data-type={entry.data.type}>
            <FeedCard entry={entry} headingLevel={headingLevel} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="filtered-feed__empty">Non c'è ancora niente qui. Torna presto.</p>
    )
  }
</div>

<style>
  .filtered-feed__filter {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-xl);
  }

  .filtered-feed__legend {
    padding: 0;
    margin-block-end: var(--space-xs);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .filtered-feed__options {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  /* Il radio resta nel DOM e riceve il focus: è solo invisibile. */
  .filtered-feed__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .filtered-feed__label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    padding: 0.35em 0.75em;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    cursor: pointer;
  }

  .filtered-feed__label:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .filtered-feed__count {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--ink-faint);
  }

  .filtered-feed__input:checked + .filtered-feed__label {
    border-color: var(--ink);
    background-color: var(--surface);
    color: var(--ink);
    font-weight: 600;
  }

  .filtered-feed__input:checked + .filtered-feed__label .filtered-feed__count {
    color: var(--ink-muted);
  }

  /* Il focus da tastiera si vede sul controllo, non sull'input nascosto. */
  .filtered-feed__input:focus-visible + .filtered-feed__label {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .filtered-feed__list {
    display: grid;
    gap: var(--space-xl) var(--space-l);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* --- Il filtro vero e proprio ------------------------------------------
     Un browser senza `:has()` mostra semplicemente tutte le entry:
     nessuna funzione persa, solo il filtro che non filtra. */
  .filtered-feed:has(#filtro-build:checked) .filtered-feed__item:not([data-type='build']),
  .filtered-feed:has(#filtro-lab:checked) .filtered-feed__item:not([data-type='lab']),
  .filtered-feed:has(#filtro-talk:checked) .filtered-feed__item:not([data-type='talk']) {
    display: none;
  }

  .filtered-feed__empty {
    color: var(--ink-muted);
  }
</style>
