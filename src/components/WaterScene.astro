---
/**
 * La scena: fondo nero quasi puro, una sorgente luminosa, nebbia
 * volumetrica intorno, acqua sotto con caustiche animate.
 *
 * È l'UNICA isola JavaScript del sito, ed è un'eccezione registrata nel
 * vincolo #1 di CLAUDE.md. Le regole che la tengono onesta:
 *   - non blocca niente: il canvas è decorativo, aria-hidden, senza eventi;
 *   - senza JavaScript resta il fondo dipinto in CSS, che è già la scena
 *     giusta — buio e una sorgente — solo ferma;
 *   - con prefers-reduced-motion disegna un fotogramma solo e si ferma;
 *   - si mette in pausa fuori dallo schermo e a scheda nascosta;
 *   - nessuna libreria: WebGL2 nudo, uno shader, nessuna dipendenza.
 *
 * I colori non sono scritti qui: li legge dalle custom property del mood
 * attivo, così scena e tipografia cambiano luce insieme.
 */
---

<div class="scene" aria-hidden="true">
  <canvas class="scene__canvas" data-water-scene></canvas>
  <div class="scene__scrim"></div>
</div>

<style>
  .scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* Il fondo dipinto: è anche il fallback se lo shader non parte mai. */
    background:
      radial-gradient(
        60% 45% at 70% 30%,
        color-mix(in srgb, var(--light-halo) 22%, transparent) 0%,
        transparent 70%
      ),
      radial-gradient(
        14% 10% at 70% 30%,
        color-mix(in srgb, var(--light-core) 55%, transparent) 0%,
        transparent 100%
      ),
      var(--void);
  }

  .scene__canvas {
    inline-size: 100%;
    block-size: 100%;
    display: block;
  }

  /* Vela sul lato del testo: tiene i titoli sopra 12:1 qualunque cosa
     faccia la luce dietro. */
  .scene__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        100deg,
        var(--void) 2%,
        color-mix(in srgb, var(--void) 80%, transparent) 26%,
        color-mix(in srgb, var(--void) 34%, transparent) 52%,
        transparent 74%
      ),
      linear-gradient(to top, var(--void) 1%, transparent 22%);
  }

  /* In colonna stretta il testo copre tutta la scena: non esiste un lato
     libero da velare. Qui la scena diventa una texture — le caustiche si
     leggono ancora come filamenti, ma sotto il testo il fondo torna nero.
     Fra una scena vistosa e un testo leggibile vince il testo. */
  @media (max-width: 55.999rem) {
    .scene__scrim {
      background:
        color-mix(in srgb, var(--void) 90%, transparent),
        linear-gradient(to top, var(--void) 2%, transparent 34%);
    }
  }
</style>

<script>
  const VERT = `#version 300 es
  void main() {
    // Triangolo a schermo intero senza buffer: le posizioni escono da gl_VertexID.
    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
  }`;

  const FRAG = `#version 300 es
  precision highp float;
  out vec4 fragColor;

  uniform vec2  uRes;
  uniform float uTime;
  uniform vec3  uLightCore;
  uniform vec3  uLightHalo;
  uniform vec3  uAccent;

  float hash(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
  }

  float noise(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
  }

  float fbm(vec2 p) {
    float v = 0.0, a = 0.5;
    for (int i = 0; i < 4; i++) { v += a * noise(p); p *= 2.03; a *= 0.5; }
    return v;
  }

  // Rumore "a cresta": il valore massimo sta sulle linee, non sulle macchie.
  float ridged(vec2 p) { return 1.0 - abs(noise(p) * 2.0 - 1.0); }

  // Caustiche: due reticoli a cresta moltiplicati fra loro su un dominio
  // deformato. È il prodotto a produrre la rete di filamenti sottili —
  // un gradiente non ci arriva, per quanto lo si animi.
  float caustics(vec2 p, float t) {
    vec2 q = p + 0.6 * vec2(fbm(p * 1.1 + t * 0.10), fbm(p * 1.1 + 5.2 - t * 0.08));
    float a = ridged(q * 2.1 + vec2(0.0, t * 0.16));
    float b = ridged(q * 3.3 + vec2(-t * 0.11, 0.0));
    return pow(clamp(a * b, 0.0, 1.0), 5.0);
  }

  void main() {
    vec2 frag = gl_FragCoord.xy;
    vec2 p = (frag - 0.5 * uRes) / uRes.y;

    const float horizon = 0.06;
    float aspect = uRes.x / uRes.y;
    float ly = mix(0.44, 0.34, clamp(aspect - 0.5, 0.0, 1.0));
    vec2  light = vec2(max(0.36 * aspect, 0.15), ly);

    vec3 col = vec3(0.020, 0.020, 0.027);

    // --- Sorgente unica: nucleo stretto più alone largo.
    float d = length(p - light);
    col += uLightCore * exp(-d * 26.0) * 1.45;
    col += uLightHalo * exp(-d * 4.2) * 0.30;

    // --- Nebbia volumetrica: densità accumulata lungo il raggio che va
    //     dal punto alla sorgente. Non è una sfumatura, è un integrale.
    float fog = 0.0;
    vec2 dir = p - light;
    const int STEPS = 20;
    for (int i = 0; i < STEPS; i++) {
      float s = float(i) / float(STEPS);
      vec2 sp = light + dir * s;
      float dens = fbm(sp * 2.6 + vec2(0.0, uTime * 0.05));
      dens *= smoothstep(1.15, 0.0, length(sp - light));
      fog += dens * (1.0 - s);
    }
    fog /= float(STEPS);
    col += uLightHalo * fog * 0.55;

    // --- L'acqua, sotto la linea d'orizzonte.
    if (p.y < horizon) {
      float depth = horizon - p.y;

      // Prospettiva: le righe vicino all'orizzonte si comprimono.
      vec2 wp = vec2(p.x / (depth + 0.045), 0.16 / (depth + 0.045));
      wp.y -= uTime * 0.05;

      float c = caustics(wp * 1.5, uTime);
      float fade = smoothstep(0.62, 0.02, depth);

      // Riflesso della sorgente: allungato in verticale e rotto dalle onde.
      float refl = exp(-abs(p.x - light.x) * (7.0 + depth * 22.0));
      refl *= 0.55 + 0.45 * noise(vec2(p.x * 14.0, uTime * 1.1 + depth * 9.0));
      refl *= smoothstep(0.62, 0.0, depth);

      col += uLightCore * refl * 0.80;
      col += uAccent    * c * fade * 0.85;
      col += uLightHalo * c * fade * 0.22;
      col += uLightHalo * exp(-depth * 140.0) * 0.45;
    }

    // Grana: senza, il nero fa banding a fasce sugli schermi a 8 bit.
    col += (hash(frag + uTime) - 0.5) * 0.016;
    col *= 1.0 - 0.35 * pow(length(p * vec2(0.62, 0.9)), 2.2);

    fragColor = vec4(max(col, vec3(0.0)), 1.0);
  }`;

  /** Legge una custom property e la porta a [r, g, b] in 0..1. */
  function readColor(styles: CSSStyleDeclaration, name: string, fallback: number[]) {
    const raw = styles.getPropertyValue(name).trim();
    if (!raw) return fallback;
    const hex = raw.match(/^#([0-9a-f]{6})$/i);
    if (hex) {
      const n = parseInt(hex[1], 16);
      return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
    }
    const nums = raw.match(/[\d.]+/g);
    if (nums && nums.length >= 3) return nums.slice(0, 3).map((v) => Number(v) / 255);
    return fallback;
  }

  function compile(gl: WebGL2RenderingContext, type: number, source: string) {
    const shader = gl.createShader(type)!;
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      gl.deleteShader(shader);
      return null;
    }
    return shader;
  }

  function start(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext('webgl2', {
      alpha: false,
      antialias: false,
      powerPreference: 'low-power',
    });
    // Nessun WebGL2: resta il fondo dipinto in CSS, che è già la scena giusta.
    if (!gl) return;

    const vs = compile(gl, gl.VERTEX_SHADER, VERT);
    const fs = compile(gl, gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;

    const program = gl.createProgram()!;
    gl.attachShader(program, vs);
    gl.attachShader(program, fs);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
    gl.useProgram(program);

    const uRes = gl.getUniformLocation(program, 'uRes');
    const uTime = gl.getUniformLocation(program, 'uTime');

    const styles = getComputedStyle(document.documentElement);
    gl.uniform3fv(gl.getUniformLocation(program, 'uLightCore'), readColor(styles, '--light-core', [0.87, 0.97, 1]));
    gl.uniform3fv(gl.getUniformLocation(program, 'uLightHalo'), readColor(styles, '--light-halo', [0.44, 0.85, 0.91]));
    gl.uniform3fv(gl.getUniformLocation(program, 'uAccent'), readColor(styles, '--accent', [0.18, 0.88, 0.77]));

    const lessMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = true;
    let frame = 0;
    let disposed = false;

    function resize() {
      // Il DPR è tagliato: la scena è sfocata per natura, il pixel in più
      // non si vede e il costo sì.
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const w = Math.max(1, Math.round(canvas.clientWidth * dpr));
      const h = Math.max(1, Math.round(canvas.clientHeight * dpr));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        gl!.viewport(0, 0, w, h);
      }
      gl!.uniform2f(uRes, canvas.width, canvas.height);
    }

    function draw(t: number) {
      resize();
      gl!.uniform1f(uTime, t);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
    }

    function loop(now: number) {
      if (disposed) return;
      draw(now / 1000);
      frame = requestAnimationFrame(loop);
    }

    function play() {
      if (disposed || frame || lessMotion.matches) return;
      frame = requestAnimationFrame(loop);
    }

    function pause() {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
    }

    function sync() {
      if (lessMotion.matches) {
        // Meno movimento: la scena resta, ferma su un fotogramma.
        pause();
        draw(0);
        return;
      }
      if (visible && !document.hidden) play();
      else pause();
    }

    new IntersectionObserver((entries) => {
      visible = entries.some((e) => e.isIntersecting);
      sync();
    }).observe(canvas);

    document.addEventListener('visibilitychange', sync);
    lessMotion.addEventListener('change', sync);
    addEventListener('resize', () => {
      if (lessMotion.matches) draw(0);
    });

    // Un fotogramma subito, così non c'è un lampo di fondo nudo.
    draw(0);
    sync();
  }

  document.querySelectorAll<HTMLCanvasElement>('[data-water-scene]').forEach(start);
</script>
