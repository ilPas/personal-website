---
import { FEED_TYPES, type FeedType } from '../consts';

interface Props {
  type: FeedType;
}

const { type } = Astro.props;
---

<!-- Etichetta discreta: distingue il tipo senza diventare un elemento grafico. -->
<span class="type-badge">{FEED_TYPES[type].label}</span>

<style>
  .type-badge {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }
</style>
