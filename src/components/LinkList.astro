---
interface Props {
  links: readonly { label: string; url: string }[];
  label?: string;
}

const { links, label = 'Link correlati' } = Astro.props;
---

{
  links.length > 0 && (
    <nav class="link-list" aria-label={label}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.url} rel="noopener">
              {link.label}
              <span aria-hidden="true">&nbsp;↗</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .link-list ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .link-list a {
    font-size: var(--text-sm);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
  }

  .link-list a:hover {
    text-decoration-color: currentColor;
  }
</style>
